{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "keyboard-inspector-analyzer",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/dist",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "nativeAllowList": [
    "app.*",
    "extensions.*"
  ],
  "singlePageServe": true,
  "modes": {
    "window": {
      "title": "Keyboard Inspector Analyzer",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "injectGlobals": true,
      "icon": "/public/icon.png",
      "enableInspector": true
    }
  },
  "cli": {
    "binaryName": "analyzer",
    "resourcesPath": "/dist",
    "extensionsPath": "/extensions/",
    "frontendLibrary": {
      "devUrl": "http://localhost:5173",
      "projectPath": "/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    },
    "distributionPath": "/dist-neu",
    "binaryVersion": "6.9.0"
  },
  "extensions": [
    {
      "id": "recorder",
      "commandLinux": "${NL_PATH}/extensions/recorder-app_linux --mode neutralino --log-path \"${NL_PATH}/logs/log.txt\""
    }
  ]
}