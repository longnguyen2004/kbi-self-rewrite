{
  "version": "2.0.0",
  "configurations": [
    {
      "name": "Launch analyzer-native",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/analyzer-native/analyzer-native",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "CMake: build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
