{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg - Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "vcpkg - Ninja - Release",
      "inherits": "vcpkg - Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg - Ninja - Debug",
      "inherits": "vcpkg - Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vcpkg - VS 2022",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Ninja - Release",
      "configurePreset": "vcpkg - Ninja - Release"
    },
    {
      "name": "Ninja - Debug",
      "configurePreset": "vcpkg - Ninja - Debug"
    },
    {
      "name": "VS 2022 - Release",
      "configurePreset": "vcpkg - VS 2022",
      "configuration": "Release"
    },
    {
      "name": "format",
      "configurePreset": "vcpkg - Ninja - Release",
      "targets": [
        "format"
      ]
    },
    {
      "name": "format-check",
      "configurePreset": "vcpkg - Ninja - Release",
      "targets": [
        "format-check"
      ]
    },
    {
      "name": "tidy",
      "configurePreset": "vcpkg - Ninja - Release",
      "targets": [
        "tidy"
      ]
    }
  ]
}
